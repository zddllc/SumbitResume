MONGO_URI=mongodb://10.0.0.44:27017
MONGO_DB=resume
APP_BASE_PATH=/resume
BIND_HOST=127.0.0.1
BIND_PORT=8000
SERVER_THREADS=4
TRUST_PROXY=false
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
SESSION_COOKIE_NAME=resume_session
COOKIE_SECURE=false
# Optional persistent locations (relative paths are based on the repo root):
# INSTANCE_DIR=.instance
# BROWSER_PROFILE_ROOT=.browser-data
# Optional custom Chrome installation:
# CHROME_PATH=C:\Tools\Chrome\chrome.exe
# CHROMEDRIVER_PATH=C:\Tools\ChromeDriver\chromedriver.exe
# Optional Unicode font override for confirmed PDF resumes:
# PDF_FONT_PATH=C:\Windows\Fonts\msyh.ttc
# Linux: PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
# Local secrets are generated once in .instance/secrets.json.
# Back up that file securely; losing its encryption key makes stored secrets unreadable.
