# Install as ~/.config/resume/resume.env with mode 600; update paths/domain.
MONGO_URI=mongodb://10.0.0.44:27017
MONGO_DB=resume
APP_BASE_PATH=/resume
BIND_HOST=127.0.0.1
BIND_PORT=8000
SERVER_THREADS=4
TRUST_PROXY=true
TRUSTED_HOSTS=10.0.0.113,resume.example.com,localhost,127.0.0.1
SESSION_COOKIE_NAME=resume_session
# Use true behind HTTPS; use false only for an HTTP LAN test.
COOKIE_SECURE=true
INSTANCE_DIR=/home/REPLACE_USER/.local/share/resume/instance
BROWSER_PROFILE_ROOT=/home/REPLACE_USER/.local/share/resume/browser
PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
# Optional explicit binaries, otherwise Selenium Manager discovers them.
# CHROME_PATH=/usr/bin/google-chrome
# CHROMEDRIVER_PATH=/usr/local/bin/chromedriver
# DISPLAY/XAUTHORITY/WAYLAND_DISPLAY are inherited from the desktop user manager.
